{
    "private": true,
    "version": "0.4.0",
    "workspaces": [
        "packages/*",
        "smart-contracts"
    ],
    "dependencies": {
        "viem": "^2.47.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.14"
    },
    "scripts": {
        "compile": "cd smart-contracts && bun run compile",
        "export-abi": "cd smart-contracts && bun run compile && bash scripts/export-abi.sh",
        "test:contracts": "cd smart-contracts && bun test",
        "test:cli": "cd packages/cli && bun test",
        "test:sdk": "cd packages/sdk && bun test",
        "test:nearai-plugin": "cd packages/nearai-verify-plugin && bun test",
        "lint": "biome check packages/cli/src packages/sdk/src packages/dashboard/src packages/openclaw-plugin/src packages/nearai-verify-plugin/src packages/nearai-verify-plugin/tests",
        "build:core": "cd packages/core && bun run build",
        "build:sdk": "cd packages/sdk && bun run build",
        "build:plugin": "cd packages/openclaw-plugin && bun run build",
        "build:nearai-plugin": "cd packages/nearai-verify-plugin && bun run build",
        "build:packages": "bun run build:core && bun run build:sdk && bun run build:plugin && bun run build:nearai-plugin",
        "plugin:manifest:check": "cd packages/openclaw-plugin && bun run manifest:check",
        "plugin:validate": "cd packages/openclaw-plugin && bun run validate",
        "build:cli": "cd packages/cli && bun run build",
        "build:dashboard": "cd packages/dashboard && bun run build",
        "dev:dashboard": "cd packages/dashboard && bun run dev",
        "version:check": "node scripts/version-check.mjs",
        "version:bump": "node scripts/version-bump.mjs"
    }
}
