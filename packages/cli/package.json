    "test:integration": "bun test tests/integration/"
  },
  "dependencies": {
    "@smartclaws/core": "workspace:*",
    "commander": "^14.0.0",
    "viem": "^2.47.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "^1.3.11",
    "typescript": "^6.0.0"
  }
