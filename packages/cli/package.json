{
    "name": "@smartclaws/cli",
    "version": "0.5.0",
    "type": "module",
    "license": "LGPL-3.0-or-later",
    "scripts": {
        "dev": "bun run src/index.ts",
        "build": "bun build --compile src/index.ts --outfile dist/smartclaws",
        "check": "tsc --noEmit",
        "lint": "biome check src/",
        "lint:fix": "biome check --fix src/",
        "test": "bun run test:unit && bun run test:integration",
        "test:unit": "bun test tests/unit/",
        "test:integration": "for test_file in tests/integration/*.test.ts; do bun test --timeout 30000 \"$test_file\" || exit 1; done"
    },
    "dependencies": {
        "@inquirer/prompts": "^7.9.0",
        "@smartclaws/core": "workspace:*",
        "@smartclaws/sdk": "workspace:*",
        "commander": "^14.0.0",
        "viem": "^2.47.0"
    },
    "devDependencies": {
        "@types/bun": "^1.3.11",
        "typescript": "^6.0.0"
    }
}
