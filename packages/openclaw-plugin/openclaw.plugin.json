{
  "id": "smartclaws",
  "name": "SmartClaws",
  "description": "Publish and read IoT telemetry on SKALE through SmartClaws.",
  "version": "0.4.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "smartclawsHome": {
        "type": "string",
        "description": "SmartClaws config directory. Defaults to SMARTCLAWS_HOME or ~/.smartclaws."
      },
      "network": {
        "type": "string",
        "description": "Default network name. Currently supported: base-testnet."
      },
      "rpcUrl": {
        "type": "string",
        "description": "Override RPC URL."
      },
      "chainId": {
        "type": "number",
        "description": "Override chain ID (required with rpcUrl when no network is set)."
      },
      "registryAddress": {
        "type": "string",
        "description": "Override registry contract address."
      },
      "allowPrivateRpc": {
        "type": "boolean",
        "description": "Allow custom RPC URLs that target loopback, private, link-local, or metadata hosts. Default false."
      },
      "maxDiscoveryPageSize": {
        "type": "number",
        "description": "Maximum discovery page size (hard ceiling 100)."
      },
      "maxSyncEntities": {
        "type": "number",
        "description": "Maximum entities a sync may hydrate (hard ceiling 1000)."
      },
      "maxReadMessages": {
        "type": "number",
        "description": "Maximum messages a read may return (hard ceiling 100)."
      },
      "maxChannelCapacityBytes": {
        "type": "string",
        "description": "Maximum channel capacity for registration, as a decimal string (hard ceiling 16777216)."
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "smartclaws_setup_status",
      "smartclaws_initialize",
      "smartclaws_configure",
      "smartclaws_attach",
      "smartclaws_sync",
      "smartclaws_home_reset",
      "smartclaws_register_group",
      "smartclaws_register_device",
      "smartclaws_register_agent",
      "smartclaws_role_grant",
      "smartclaws_role_revoke",
      "smartclaws_view_key_generate",
      "smartclaws_view_key_rotate",
      "smartclaws_view_key_register",
      "smartclaws_view_key_forget",
      "smartclaws_view_key_remove",
      "smartclaws_wallet_info",
      "smartclaws_list_local",
      "smartclaws_discover",
      "smartclaws_access_check",
      "smartclaws_read",
      "smartclaws_reader_list",
      "smartclaws_reader_grant",
      "smartclaws_reader_revoke",
      "smartclaws_backup_list",
      "smartclaws_disclose",
      "smartclaws_publish",
      "smartclaws_notify"
    ]
  },
  "toolMetadata": {
    "smartclaws_initialize": {
      "optional": true
    },
    "smartclaws_configure": {
      "optional": true
    },
    "smartclaws_attach": {
      "optional": true
    },
    "smartclaws_sync": {
      "optional": true
    },
    "smartclaws_home_reset": {
      "optional": true
    },
    "smartclaws_register_group": {
      "optional": true
    },
    "smartclaws_register_device": {
      "optional": true
    },
    "smartclaws_register_agent": {
      "optional": true
    },
    "smartclaws_role_grant": {
      "optional": true
    },
    "smartclaws_role_revoke": {
      "optional": true
    },
    "smartclaws_view_key_generate": {
      "optional": true
    },
    "smartclaws_view_key_rotate": {
      "optional": true
    },
    "smartclaws_view_key_register": {
      "optional": true
    },
    "smartclaws_view_key_forget": {
      "optional": true
    },
    "smartclaws_view_key_remove": {
      "optional": true
    },
    "smartclaws_reader_grant": {
      "optional": true
    },
    "smartclaws_reader_revoke": {
      "optional": true
    },
    "smartclaws_disclose": {
      "optional": true
    },
    "smartclaws_publish": {
      "optional": true
    },
    "smartclaws_notify": {
      "optional": true
    }
  }
}
